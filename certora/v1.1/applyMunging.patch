# Work around Certora storage analysis failing on fields shadowing ERC20's _name/_symbol.
--- MetaMorphoV1_1.sol
+++ MetaMorphoV1_1.sol
@@ -109,10 +109,10 @@
     uint256 public lostAssets;
 
     /// @dev "Overrides" the ERC20's storage variable to be able to modify it.
-    string private _name;
+    string private _vaultName;
 
     /// @dev "Overrides" the ERC20's storage variable to be able to modify it.
-    string private _symbol;
+    string private _vaultSymbol;
 
     /* CONSTRUCTOR */
 
@@ -137,10 +137,10 @@
         if (initialTimelock != 0) _checkTimelockBounds(initialTimelock);
         _setTimelock(initialTimelock);
 
-        _name = __name;
+        _vaultName = __name;
         emit EventsLib.SetName(__name);
 
-        _symbol = __symbol;
+        _vaultSymbol = __symbol;
         emit EventsLib.SetSymbol(__symbol);
 
         MORPHO = IMorpho(morpho);
@@ -199,13 +199,13 @@
     /* ONLY OWNER FUNCTIONS */
 
     function setName(string memory newName) external onlyOwner {
-        _name = newName;
+        _vaultName = newName;
 
         emit EventsLib.SetName(newName);
     }
 
     function setSymbol(string memory newSymbol) external onlyOwner {
-        _symbol = newSymbol;
+        _vaultSymbol = newSymbol;
 
         emit EventsLib.SetSymbol(newSymbol);
     }
@@ -518,11 +518,11 @@
     }
 
     function name() public view override(IERC20Metadata, ERC20) returns (string memory) {
-        return _name;
+        return _vaultName;
     }
 
     function symbol() public view override(IERC20Metadata, ERC20) returns (string memory) {
-        return _symbol;
+        return _vaultSymbol;
     }
 
     /// @inheritdoc IERC4626
